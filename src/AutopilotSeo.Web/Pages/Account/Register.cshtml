@page
@model AutopilotSeo.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "ثبت‌نام";
    ViewData["Bare"] = true;
}
<div class="auth">
    <div class="auth__box">
        <a class="brand" href="/"><partial name="_Brand" /></a>
        <h1>شروع آزمایش رایگان</h1>
        <p>۷ روز، بدون کارت بانکی. هفتهٔ اول فقط سایتت را می‌خوانیم.</p>
        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="form-errors"></div>
            <div class="field">
                <label asp-for="Input.FullName">نام و نام خانوادگی</label>
                <input asp-for="Input.FullName" class="input" autocomplete="name" />
                <span asp-validation-for="Input.FullName" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Email">ایمیل</label>
                <input asp-for="Input.Email" class="input" dir="ltr" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Password">رمز عبور</label>
                <input asp-for="Input.Password" type="password" class="input" dir="ltr" autocomplete="new-password" />
                <small>دست‌کم ۸ کاراکتر، شامل یک رقم.</small>
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>
            <button class="btn" type="submit">ساخت حساب</button>
        </form>
        <p class="auth__alt">حساب داری؟ <a href="/account/login">وارد شو</a></p>
    </div>
</div>
