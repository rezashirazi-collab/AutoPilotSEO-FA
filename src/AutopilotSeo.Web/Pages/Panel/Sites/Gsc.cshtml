@page "/panel/sites/{id:int}/gsc"
@model AutopilotSeo.Web.Pages.Panel.Sites.GscModel
@{ ViewData["Title"] = "سرچ کنسول"; }

<div class="main__head">
    <div>
        <div class="crumbs"><a href="/panel">سایت‌ها</a> / <a href="/panel/sites/@Model.Site.Id" class="ltr">@Model.Site.Domain</a></div>
        <h1>اتصال سرچ کنسول</h1>
        @if (Model.Conn.GoogleEmail != "") { <p>حساب گوگل: <span class="ltr">@Model.Conn.GoogleEmail</span></p> }
    </div>
</div>

<div class="grid-2">
    <div class="box">
        <div class="box__head"><h2>انتخاب property</h2></div>
        <div class="box__body">
            @if (Model.Revoked)
            {
                <p class="muted">دسترسی این حساب به سرچ کنسول باطل شده است. دوباره وصل شوید.</p>
                <a class="btn" href="/oauth/google/start/@Model.Site.Id" style="margin-top:16px">اتصال دوباره</a>
            }
            else if (Model.Matching.Count == 0)
            {
                <p>این حساب گوگل به هیچ property مربوط به <b class="ltr">@Model.Site.Domain</b> دسترسی ندارد@(Model.OtherCount > 0 ? $" (به {Fa.Num(Model.OtherCount)} property دیگر دسترسی دارد)" : "").</p>
                <p class="muted" style="margin-top:8px">با حسابی وارد شوید که در سرچ کنسول این سایت مالک یا کاربر است.</p>
                <a class="btn" href="/oauth/google/start/@Model.Site.Id" style="margin-top:16px">اتصال با حساب دیگر</a>
            }
            else
            {
                <form method="post" asp-page-handler="Select" asp-route-id="@Model.Site.Id" style="display:grid;gap:12px">
                    @for (var i = 0; i < Model.Matching.Count; i++)
                    {
                        var p = Model.Matching[i];
                        var isDomain = p.SiteUrl.StartsWith("sc-domain:");
                        <label class="check">
                            <input type="radio" name="property" value="@p.SiteUrl" checked="@(Model.Conn.Property == p.SiteUrl || (Model.Conn.Property is null && i == 0))" />
                            <span>
                                <b class="ltr">@p.SiteUrl</b><br />
                                <small class="muted">@(isDomain ? "Domain property؛ همهٔ زیردامنه‌ها و http/https را پوشش می‌دهد (پیشنهادی)" : "URL-prefix property؛ فقط همین پیشوند")</small>
                            </span>
                        </label>
                    }
                    <div><button class="btn" type="submit">شروع دریافت داده</button></div>
                </form>
            }
        </div>
    </div>

    <div class="box">
        <div class="box__body">
            <h2 style="font-size:16px">چه داده‌ای خوانده می‌شود؟</h2>
            <ul class="facts" style="margin-top:12px">
                <li>کلیک، نمایش، CTR و جایگاه ۱۶ ماه اخیر، به تفکیک کوئری، صفحه و دستگاه.</li>
                <li>از این به بعد هر روز داده‌های تازه اضافه می‌شود و تاریخچه بعد از ۱۶ ماه هم نزد ما می‌ماند.</li>
                <li>دسترسی فقط خواندنی است؛ هیچ تنظیمی در سرچ کنسول تغییر نمی‌کند.</li>
            </ul>
            <form method="post" asp-page-handler="Disconnect" asp-route-id="@Model.Site.Id" style="margin-top:20px">
                <button class="btn btn--danger btn--sm" type="submit">قطع اتصال و پس گرفتن دسترسی</button>
            </form>
        </div>
    </div>
</div>
