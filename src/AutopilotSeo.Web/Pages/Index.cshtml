@page
@model IndexModel
@{
    ViewData["Description"] = "سئو خودران به سرچ کنسول و وردپرس وصل می‌شود، هر هفته مهم‌ترین کار سئوی سایت را با شاهد داده پیشنهاد می‌دهد و بعد از تأیید شما اجرا و اثرش را اندازه می‌گیرد.";
}

<section class="hero">
    <div class="wrap hero__in">
        <div>
            <h1>قبل از نوشتن مقالهٔ تازه، صفحه‌هایی که داری را بهتر می‌کند.</h1>
            <p class="hero__lead">
                سئو خودران به سرچ کنسول و وردپرس وصل می‌شود و هر هفته داده‌های سایتت را می‌خواند.
                مهم‌ترین کار بعدی را با شاهدش جلوی تو می‌گذارد؛ تو تأیید می‌کنی، او اجرا می‌کند،
                از قبلِ تغییر نسخه نگه می‌دارد و اثرش را اندازه می‌گیرد.
            </p>
            <div class="hero__cta">
                <a class="btn" href="/account/register">سایتم را وصل کن</a>
                <a class="btn btn--ghost" href="#order">ببین چطور کار می‌کند</a>
            </div>
            <p class="hero__note">۷ روز آزمایش رایگان، همراه با گزارش وضعیت فعلی سایت.</p>
        </div>

        <article class="proposal" aria-label="نمونهٔ یک پیشنهاد در صف تأیید">
            <div class="proposal__head">
                <span>پیشنهاد این هفته برای یک فروشگاه قهوه</span>
                <span class="risk risk--2">ریسک متوسط</span>
            </div>
            <div class="proposal__body">
                <h2 class="proposal__title">عنوان صفحهٔ «قهوه‌ساز اسپرسو» را بازنویسی کن</h2>
                <div class="evidence">
                    <div class="muted">شاهد از سرچ کنسول، ۲۸ روز اخیر</div>
                    <div class="evidence__q">«قیمت قهوه ساز اسپرسو خانگی»</div>
                    <div class="evidence__stats">
                        <div><b>۱۲٬۴۰۰</b><small>نمایش</small></div>
                        <div><b>۶٫۸</b><small>جایگاه میانگین</small></div>
                        <div class="evidence__gap"><b>۱٫۱٪</b><small>CTR؛ انتظار سایت ۳٫۴٪</small></div>
                    </div>
                </div>
                <div class="diff">
                    <div class="diff__row diff__row--old"><span>قبل</span><p>قهوه ساز | فروشگاه ما</p></div>
                    <div class="diff__row diff__row--new"><span>بعد</span><p>قیمت و خرید قهوه‌ساز اسپرسو خانگی؛ مقایسهٔ ۱۲ مدل</p></div>
                </div>
                <p class="proposal__effect">اثر تخمینی: <b>حدود ۲۸۰ کلیک بیشتر در ماه</b>. اندازه‌گیری واقعی ۵ هفته بعد.</p>
            </div>
            <div class="proposal__foot">
                <span class="btn btn--approve btn--sm" aria-hidden="true">تأیید و اجرا</span>
                <span class="btn btn--ghost btn--sm" aria-hidden="true">رد با دلیل</span>
                <small>برگشت با یک کلیک</small>
            </div>
        </article>
    </div>
</section>

<section class="section" id="order">
    <div class="wrap">
        <div class="section__head">
            <h2>ترتیب کار ثابت است</h2>
            <p>سیستم از سریع‌ترین برد شروع می‌کند. محتوای تازه آخر صف است و فقط برای جاهای خالیِ نقشهٔ موضوعی نوشته می‌شود، نه ماهی سی مقاله.</p>
        </div>
        <ol class="order">
            <li><h3>فنی و ایندکس</h3><p>صفحه‌ای که ایندکس نشده رتبه هم نمی‌گیرد. خطای کراول، canonical و نقشهٔ سایت اول.</p></li>
            <li><h3>نزدیک صفحهٔ اول</h3><p>صفحه‌هایی با نمایش زیاد در جایگاه ۴ تا ۲۰، و عنوان‌هایی که کمتر از انتظار کلیک می‌گیرند.</p></li>
            <li><h3>صفحه‌های افت‌کرده</h3><p>اول نوع افت مشخص می‌شود. افتِ تقاضا یا AI Overview با بازنویسی درست نمی‌شود.</p></li>
            <li><h3>ساختار و لینک داخلی</h3><p>منو، صفحه‌های مادر و لینک از عبارت‌هایی که همین حالا در متن هستند.</p></li>
            <li><h3>محتوای جدید</h3><p>بریف از تحلیل نتایج گوگل، با لحن برند خودت، و بعد از تأیید تو منتشر می‌شود.</p></li>
            <li class="is-last"><h3>لینک خارجی</h3><p>فقط پیشنهاد و پیگیری. لینک نمی‌خریم و تبادل لینک نداریم.</p></li>
        </ol>
    </div>
</section>

<section class="section" id="profile">
    <div class="wrap split">
        <div class="section__head">
            <h2>تا کسب‌وکارت را نشناسد، پیشنهادی نمی‌دهد</h2>
            <p>هفتهٔ اول فقط می‌خواند: کراول کامل، ۱۶ ماه دادهٔ سرچ کنسول و نتایج گوگل برای کلمات اصلی. از روی آن پیش‌نویس پروندهٔ کسب‌وکارت را می‌سازد و فقط چیزهایی را می‌پرسد که مطمئن نیست.</p>
            <p>کلمه‌ای که به کار تو مربوط نیست، با هر حجم جستجویی، کنار گذاشته می‌شود.</p>
        </div>
        <ul class="profile-list">
            <li><b>هدف</b><span>فروش، لید، تماس یا رزرو؛ با یک شاخص و یک عدد. ارزش هر فرصت از همین می‌آید.</span></li>
            <li><b>محصولات اولویت‌دار</b><span>تحقیق کلمات از این‌ها شروع می‌شود و لینک‌های داخلی به صفحه‌هایشان می‌رسد.</span></li>
            <li><b>رقبا</b><span>آن‌هایی که خودت می‌شناسی، به‌اضافهٔ رقبایی که در نتایج گوگل پیدا می‌شوند.</span></li>
            <li><b>لحن برند</b><span>سه نمونه متن می‌سازد، تو ویرایش می‌کنی و راهنمای لحن سایتت از همین تفاوت‌ها درمی‌آید.</span></li>
            <li><b>خط قرمزها</b><span>ادعاهای ممنوع، رقبایی که نباید نامشان بیاید، صفحه‌هایی که دست نمی‌خورند. این‌ها فیلتر برنامه‌ای‌اند، نه خواهش از هوش مصنوعی.</span></li>
        </ul>
    </div>
</section>

<section class="section" id="safety">
    <div class="wrap">
        <div class="section__head">
            <h2>هرچه تغییر پرخطرتر، تأییدش سخت‌تر</h2>
            <p>هر نوع تغییر یک سطح ریسک دارد و همین سطح تعیین می‌کند چه کسی باید تأییدش کند. حالت خودران فقط سطح یک را بدون پرسیدن انجام می‌دهد، آن هم با سقف روزانه.</p>
        </div>
        <div class="ladder">
            <div class="ladder__step">
                <div class="ladder__level">سطح ۰</div>
                <h3>فقط خواندن</h3>
                <p>تحلیل، بررسی ایندکس، گزارش و اعلام صفحهٔ تازه به موتورها.</p>
                <div class="ladder__gate">خودکار</div>
            </div>
            <div class="ladder__step">
                <div class="ladder__level">سطح ۱</div>
                <h3>کم‌خطر</h3>
                <p>توضیح متا، متن جایگزین تصویر، اسکیما، لینک داخلی در متن موجود.</p>
                <div class="ladder__gate">با تأیید تو؛ در حالت خودران با سقف</div>
            </div>
            <div class="ladder__step">
                <div class="ladder__level">سطح ۲</div>
                <h3>متوسط</h3>
                <p>عنوان و H1، بازنویسی یا گسترش بخشی از صفحه، انتشار مقالهٔ جدید.</p>
                <div class="ladder__gate">همیشه با تأیید تو</div>
            </div>
            <div class="ladder__step">
                <div class="ladder__level">سطح ۳</div>
                <h3>پرخطر</h3>
                <p>ریدایرکت، ادغام یا حذف صفحه، canonical و noindex، منو، فوتر و ساختار سایت.</p>
                <div class="ladder__gate">ناظر سئو و تو، با پیش‌نمایش. هرگز خودکار.</div>
            </div>
        </div>
        <p class="never"><b>چیزهایی که اصلاً نمی‌سازیم:</b> شبکهٔ تبادل لینک، خرید خودکار لینک، انتشار انبوه مقاله، تغییر صفحه با کد جاوااسکریپت یا نسخهٔ جدا برای ربات‌ها، و وعدهٔ رتبه.</p>
        <div class="rules">
            <div><h3>نسخهٔ قبل از هر تغییر</h3><p>متن، متا، لینک‌های اضافه‌شده و منو ذخیره می‌شوند. برگشت همه‌چیز با یک کلیک.</p></div>
            <div><h3>کلید توقف</h3><p>هر لحظه می‌توانی همهٔ اقدامات روی سایتت را متوقف کنی.</p></div>
            <div><h3>صفحه‌های محافظت‌شده</h3><p>پرداخت، قیمت، قوانین و هر صفحه‌ای که علامت بزنی، خودکار ویرایش نمی‌شود.</p></div>
            <div><h3>تغییرات می‌مانند</h3><p>همه‌چیز مستقیم در وردپرس نوشته می‌شود؛ با لغو اشتراک هم سر جایش می‌ماند.</p></div>
        </div>
    </div>
</section>

<section class="section" id="impact">
    <div class="wrap split">
        <div class="section__head">
            <h2>اثر هر تغییر را با گروه کنترل می‌سنجد</h2>
            <p>بالا رفتن کلیک بعد از یک تغییر لزوماً کار آن تغییر نیست. برای همین صفحهٔ تغییرکرده کنار صفحه‌های دست‌نخوردهٔ مشابه سنجیده می‌شود.</p>
            <ul class="facts">
                <li><b>۲۸ روز قبل در برابر ۲۸ روز بعد</b>، بدون ۷ روز اول که گوگل هنوز صفحه را دوباره نخزیده.</li>
                <li>اگر آپدیت گوگل وسط دوره باشد، نتیجه <b>«نامشخص»</b> اعلام می‌شود، نه برد.</li>
                <li>صفحه تا آخر دورهٔ سنجش دوباره عوض نمی‌شود تا اثرش قاطی نشود.</li>
            </ul>
        </div>
        <figure class="chart" style="margin:0">
            <svg viewBox="0 0 600 260" role="img" aria-label="نمودار کلیک روزانهٔ صفحهٔ تغییرکرده در برابر گروه کنترل، قبل و بعد از تغییر">
                <rect x="310" y="20" width="68" height="200" fill="#f2f4f7"/>
                <line x1="40" y1="220" x2="580" y2="220" stroke="#dce1e8"/>
                <line x1="310" y1="20" x2="310" y2="220" stroke="#172033" stroke-dasharray="3 4"/>
                <polyline fill="none" stroke="#7a8396" stroke-width="2.5" stroke-dasharray="6 5" points="40,186 80,182 120,188 160,180 200,184 240,178 280,182 310,180 345,178 378,176 420,177 460,173 500,175 540,171 580,170"/>
                <polyline fill="none" stroke="#1e8a5a" stroke-width="3" points="40,172 80,165 120,170 160,162 200,168 240,160 280,164 310,162 345,150 378,138 420,128 460,120 500,116 540,110 580,106"/>
                <path d="M566 108 h8 v48 h-8" fill="none" stroke="#172033" stroke-width="1.5"/>
                <g font-family="Estedad, Tahoma" fill="#4b5569" font-size="12.5">
                    <text x="558" y="138" text-anchor="end" font-size="13" font-weight="700" fill="#172033">اثر خالص</text>
                    <text x="372" y="40" text-anchor="end">۷ روز</text>
                    <text x="372" y="58" text-anchor="end">حساب نمی‌شود</text>
                    <text x="300" y="244" text-anchor="end">۲۸ روز قبل</text>
                    <text x="320" y="244" text-anchor="start">۲۸ روز بعد از تغییر</text>
                </g>
            </svg>
            <figcaption class="chart__legend">
                <span style="--c:#1e8a5a"><i></i>صفحهٔ تغییرکرده</span>
                <span style="--c:#7a8396"><i></i>صفحه‌های مشابهِ دست‌نخورده</span>
            </figcaption>
        </figure>
    </div>
</section>

<section class="closing">
    <div class="wrap closing__in">
        <div>
            <h2>سایتت را وصل کن؛ هفتهٔ اول فقط می‌خوانیم.</h2>
            <p>بعد از اتصال، گزارش وضعیت فعلی سایت و پیش‌نویس پروندهٔ کسب‌وکارت آماده می‌شود.</p>
        </div>
        <a class="btn" href="/account/register">شروع آزمایش رایگان</a>
    </div>
</section>
